+
+func (c *Client) Logout(session *api.Session) error {
+	req, err := api.NewRequest(http.MethodDelete, c.config.APIURL+constants.AuthPath, nil, session)
+	if err != nil {
+		return err
+	}
+
+	var resp struct {
+		Code  int    `json:"Code"`
+		Error string `json:"Error,omitempty"`
+	}
+	if err := api.Do(c.httpClient, req, &resp); err != nil {
+		return err
+	}
+
+	if resp.Code != CodeSuccess {
+		return fmt.Errorf("logout failed (code %d): %s", resp.Code, resp.Error)
+	}
+	return nil
+}
