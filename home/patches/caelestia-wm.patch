diff --git a/daemons/Shortcuts.qml b/daemons/Shortcuts.qml
index adc4e4c..6b6fe6e 100644
--- a/daemons/Shortcuts.qml
+++ b/daemons/Shortcuts.qml
@@ -47,6 +47,20 @@ Scope {
         }
     }
 
+    CustomShortcut {
+        name: "keybinds"
+        description: "Toggle the keybind reference"
+        onPressed: {
+            if (root.hasFullscreen)
+                return;
+            const screenState = ShellState.forActive();
+            const tab = [Config.dashboard.showDashboard, Config.dashboard.showMedia, Config.dashboard.showPerformance, Config.dashboard.showWeather].filter(Boolean).length;
+            const showing = screenState.dashboard && screenState.dashboardTab === tab;
+            screenState.dashboardTab = tab;
+            screenState.dashboard = !showing;
+        }
+    }
+
     // qmllint disable unresolved-type
     CustomShortcut {
         // qmllint enable unresolved-type
