+# MegaPlay stores its source config as base64url-encoded AES-256-CBC.
+megaplay_decrypt() {
+    _b64="$(printf "%s" "$1" | tr '_-' '/+')"
+    case $((${#_b64} % 4)) in
+        0) ;;
+        2) _b64="${_b64}==" ;;
+        3) _b64="${_b64}=" ;;
+        *) return 1 ;;
+    esac
+    b64_decode "$_b64" |
+        openssl enc -d -aes-256-cbc \
+            -K 693f4c4d5441783051362c3a7d35305500000000000000000000000000000000 \
+            -iv 57303b3237546f6155706c5f50252763 \
+            2>/dev/null
+}
+
+# Some MegaPlay CDN pools answer a 302 to cloudflare-terms-of-service-abuse.com, which mpv waits on forever.
+megaplay_cdn_ok() {
+    _probe_variant="$(hianime_curl "$1" -e "https://megaplay.buzz/" | grep -v '^#' | head -n 1)"
+    [ -z "$_probe_variant" ] && return 1
+    case "$_probe_variant" in http*) ;; *) _probe_variant="${1%/*}/$_probe_variant" ;; esac
+    _probe_segment="$(hianime_curl "$_probe_variant" -e "https://megaplay.buzz/" | grep -v '^#' | head -n 1)"
+    [ -z "$_probe_segment" ] && return 1
+    case "$_probe_segment" in http*) ;; *) _probe_segment="${_probe_variant%/*}/$_probe_segment" ;; esac
+    #shellcheck disable=SC2086
+    _probe_code="$($curl_exe -s -o /dev/null -w '%{http_code}' -A "$agent" --max-time 10 $cipher_flag -e "https://megaplay.buzz/" "$_probe_segment")"
+    case "$_probe_code" in 2??) return 0 ;; *) return 1 ;; esac
+}
+
+megaplay_master() {
+    for _cdn in "" "&s=bcdn"; do
+        _src_json="$(hianime_curl \
+            "https://megaplay.buzz/videojs/stream/getSources?id=$1$_cdn" \
+            -H "Origin: https://megaplay.buzz" \
+            -H "X-Requested-With: XMLHttpRequest" \
+            -e "$2" \
+            -b "$_megaplay_cookie" \
+            -c "$_megaplay_cookie")"
+        _enc="$(printf "%s" "$_src_json" | tr -d '\n' | sed -nE 's|.*"enc"[[:space:]]*:[[:space:]]*"([^"]+)".*|\1|p')"
+        [ -z "$_enc" ] && continue
+        _json="$(megaplay_decrypt "$_enc")" || continue
+        _m3u8_master="$(printf "%s" "$_json" | tr -d '\n' | sed -nE 's|.*"file"[[:space:]]*:[[:space:]]*"([^"]*\.m3u8[^"]*)".*|\1|p')"
+        [ -n "$_m3u8_master" ] && megaplay_cdn_ok "$_m3u8_master" && return 0
+    done
+    return 1
+}
+
+megaplay_track() {
+    printf "%s" "$_src_json" | sed 's|},{|}\n{|g' | grep -E -m 1 "$1" |
+        sed -nE 's|.*"file"[[:space:]]*:[[:space:]]*"([^"]*)".*|\1|p' | sed 's|\\/|/|g'
+}
+
+megaplay_audio() {
+    case "$2" in
+        dub) _wanted='LANGUAGE="en' ;;
+        *) _wanted='LANGUAGE="ja' ;;
+    esac
+    _renditions="$(printf "%s\n" "$1" | grep '^#EXT-X-MEDIA:TYPE=AUDIO')"
+    [ -z "$_renditions" ] && return 0
+    _rendition="$(printf "%s\n" "$_renditions" | grep -m 1 -F "$_wanted")"
+    [ -z "$_rendition" ] && _rendition="$(printf "%s\n" "$_renditions" | grep -m 1 -F 'DEFAULT=YES')"
+    [ -z "$_rendition" ] && _rendition="$(printf "%s\n" "$_renditions" | head -n 1)"
+    printf "%s" "$_rendition" | sed -nE 's|.*URI="([^"]*)".*|\1|p' | sed "\|^https*://|!s|^|${_m3u8_master%/*}/|"
+}
+
+# hianime renamed the MegaPlay server Vidstream-2 -> HD-1, and its embed points at /stream/ while the working player is /videojs/stream/.
+hianime_megaplay() {
+    _hash="$(printf "%s\n" "$_servers" | sed -nE 's|.*data-type="'"$1"'".*data-server-name="(Vidstream-2\|HD-1)".*data-hash="([^"]*)".*|\2|p' | head -n 1)"
+    [ -z "$_hash" ] && return 1
+    _embed="$(b64_decode "$_hash")"
+    case "$_embed" in
+        https://megaplay.buzz/stream/*) _embed="https://megaplay.buzz/videojs/${_embed#https://megaplay.buzz/}" ;;
+        https://megaplay.buzz/videojs/stream/*) ;;
+        *) return 1 ;;
+    esac
+    _megaplay_cookie="${TMPDIR:-/tmp}/ani-cli-megaplay-$$.cookie"
+    rm -f "$_megaplay_cookie"
+    _data_id="$(hianime_curl "$_embed" -e "https://megaplay.buzz/" -c "$_megaplay_cookie" -b "$_megaplay_cookie" |
+        sed -nE 's|.*data-id="([0-9]+)".*|\1|p' | head -n 1)"
+    _found=1
+    [ -n "$_data_id" ] && megaplay_master "$_data_id" "$_embed" && _found=0
+    rm -f "$_megaplay_cookie"
+    _megaplay_cookie=""
+    [ "$_found" = 0 ] || return 1
+    sub_link="$(megaplay_track '"label"[[:space:]]*:[[:space:]]*"English"')"
+    [ -z "$sub_link" ] && sub_link="$(megaplay_track '"kind"[[:space:]]*:[[:space:]]*"captions"')"
+    refr="https://megaplay.buzz/"
+    mal_id=""
+    _playlist="$(hianime_curl "$_m3u8_master" -e "$refr")"
+    links="$(printf "%s\n" "$_playlist" | sed 's|^#EXT-X-STREAM.*x||g; s|,.*|p|g; /^#/d; $!N; s|\n| >|;/EXT-X-I-FRAME/d' | sed "\|>https*://|!s|>|>${_m3u8_master%/*}/|" | sort -g -r -s)"
+    audio_link="$(megaplay_audio "$_playlist" "$1")"
+    [ -n "$links" ]
+}
+
 # resolves episode $1 in mode $2 (sub/dub): sets links (quality >url per line), sub_link, mal_id and refr
 hianime_m3u8() {
     _ep_id=$(printf "%s" "$episode_maps" | sed -nE "s|^([0-9]+)\t${1}$|\1|p")
     #shellcheck disable=SC2059
     _servers="$(hianime_curl "$(printf "$servers_api" "$_ep_id")" | sed 's|\\"|"|g; s|server-item|\nserver-item|g')"
+    hianime_megaplay "$2" && return 0
     # only the zokoanime embed is understood by deobfuscate_blob, the other servers use different players
     _hash="$(printf "%s\n" "$_servers" | sed -nE 's|.*data-type="'"$2"'".*data-server-name="ZokoAnime".*data-hash="([^"]*)".*|\1|p' | head -n 1)"
     _embed="$(b64_decode "$_hash")"
@@ -571,6 +667,7 @@ done
