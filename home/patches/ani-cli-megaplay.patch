+    fi
+
+    _master="$(hianime_curl "$_m3u8_master" -e "$refr")"
+
+    # Quality variants are relative to the master playlist.
+    links="$(printf "%s\n" "$_master" |
+        sed 's|^#EXT-X-STREAM.*x||g; s|,.*|p|g; /^#/d; $!N; s|\n| >|;/EXT-X-I-FRAME/d' |
+        sed "\|>https*://|!s|>|>${_m3u8_master%/*}/|" |
+        sort -g -r -s)"
+
+    # A dual-audio source keeps its audio in EXT-X-MEDIA renditions, so the quality variant
+    # on its own is video-only and plays silent; the rendition goes to the player as an
+    # external audio track.
+    audio_link=""
+    _renditions="$(printf "%s\n" "$_master" | grep '^#EXT-X-MEDIA:TYPE=AUDIO' || true)"
+
+    if [ -n "$_renditions" ]; then
+        case "$2" in
+            dub) _wanted='LANGUAGE="en' ;;
+            *) _wanted='LANGUAGE="ja' ;;
+        esac
+
+        _rendition="$(printf "%s\n" "$_renditions" | grep -m 1 -F "$_wanted")"
+        [ -z "$_rendition" ] && _rendition="$(printf "%s\n" "$_renditions" | grep -m 1 -F 'DEFAULT=YES')"
+        [ -z "$_rendition" ] && _rendition="$(printf "%s\n" "$_renditions" | head -n 1)"
+
+        audio_link="$(printf "%s" "$_rendition" | sed -nE 's|.*URI="([^"]*)".*|\1|p')"
+        case "$audio_link" in
+            "" | http*) ;;
+            *) audio_link="${_m3u8_master%/*}/$audio_link" ;;
+        esac
+    fi
+
     [ -n "$links" ]
