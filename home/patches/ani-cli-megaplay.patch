+    # Prefer the current MegaPlay source; hianime renamed that server Vidstream-2 -> HD-1.
+    _hash="$(printf "%s\n" "$_servers" | sed -nE 's|.*data-type="'"$2"'".*data-server-name="(Vidstream-2\|HD-1)".*data-hash="([^"]*)".*|\2|p' | head -n 1)"
