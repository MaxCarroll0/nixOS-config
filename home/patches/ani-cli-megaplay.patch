+# MegaPlay spreads streams over several CDN pools and some of them answer a 302 to
+# cloudflare-terms-of-service-abuse.com for us, which mpv sits on forever. One segment
+# says whether the pool this request landed on actually serves.
+megaplay_cdn_ok() {
+    _probe_variant="$(hianime_curl "$1" -e "https://megaplay.buzz/" | grep -v '^#' | head -n 1)"
+    [ -z "$_probe_variant" ] && return 1
+    case "$_probe_variant" in http*) ;; *) _probe_variant="${1%/*}/$_probe_variant" ;; esac
+
+    _probe_segment="$(hianime_curl "$_probe_variant" -e "https://megaplay.buzz/" | grep -v '^#' | head -n 1)"
+    [ -z "$_probe_segment" ] && return 1
+    case "$_probe_segment" in http*) ;; *) _probe_segment="${_probe_variant%/*}/$_probe_segment" ;; esac
+
+    #shellcheck disable=SC2086
+    _probe_code="$($curl_exe -s -o /dev/null -w '%{http_code}' -A "$agent" --max-time 10 $cipher_flag -e "https://megaplay.buzz/" "$_probe_segment")"
+    case "$_probe_code" in 2??) return 0 ;; *) return 1 ;; esac
+}
