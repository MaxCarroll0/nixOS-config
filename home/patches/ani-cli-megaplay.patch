+        # ani-cli currently exposes the English subtitle track.
+        sub_link="$(printf "%s" "$_src_json" |
+            sed 's|},{|}\n{|g' |
+            grep -E -m 1 '"label"[[:space:]]*:[[:space:]]*"English"' |
+            sed -nE 's|.*"file"[[:space:]]*:[[:space:]]*"([^"]*)".*|\1|p')"
+
+        # Fall back to the first caption track if there is no English label.
+        if [ -z "$sub_link" ]; then
+            sub_link="$(printf "%s" "$_src_json" |
+                sed 's|},{|}\n{|g' |
+                grep -E -m 1 '"kind"[[:space:]]*:[[:space:]]*"captions"' |
+                sed -nE 's|.*"file"[[:space:]]*:[[:space:]]*"([^"]*)".*|\1|p')"
