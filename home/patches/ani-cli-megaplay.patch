+# MegaPlay stores its source config as base64url-encoded AES-256-CBC.
+megaplay_decrypt() {
+    _b64="$(printf "%s" "$1" | tr '_-' '/+')"
+
+    case $((${#_b64} % 4)) in
+        0) ;;
+        2) _b64="${_b64}==" ;;
+        3) _b64="${_b64}=" ;;
+        *) return 1 ;;
+    esac
+
+    b64_decode "$_b64" |
+        openssl enc -d -aes-256-cbc \
+            -K 693f4c4d5441783051362c3a7d35305500000000000000000000000000000000 \
+            -iv 57303b3237546f6155706c5f50252763 \
+            2>/dev/null
+}
